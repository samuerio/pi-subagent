{
  "name": "@eggmasonvalue/pi-subagent",
  "version": "1.2.0",
  "description": "Observable, isolated-context subagent for pi — delegate a task to a child pi process, flush partial results on interrupt, lean machine-facing envelope, optional model allowlist. Fan out by issuing multiple subagent calls in the same turn.",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "subagents",
    "agents",
    "orchestration",
    "observability",
    "fault-tolerant",
    "isolated-context",
    "parallel"
  ],
  "license": "MIT",
  "author": "eggmasonvalue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggmasonvalue/pi-subagent.git"
  },
  "homepage": "https://github.com/eggmasonvalue/pi-subagent#readme",
  "bugs": {
    "url": "https://github.com/eggmasonvalue/pi-subagent/issues"
  },
  "pi": {
    "extensions": [
      "extensions/subagent/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^26.3.0"
  }
}
